# Select two nominal attributes: 'sex' and 'embarked'
print("\nMeasuring dissimilarity between 'sex' and 'embarked':")

# Create contingency table
contingency = pd.crosstab(titanic['sex'], titanic['embarked'])
print("\nContingency Table:")
print(contingency)

# Simple matching coefficient (SMC) for nominal attributes
def nominal_dissimilarity(attr1, attr2):
    """Calculate dissimilarity between two nominal attributes"""
    # Create dummy variables
    dummies1 = pd.get_dummies(attr1)
    dummies2 = pd.get_dummies(attr2)
    
    # Combine and calculate mismatch proportion
    combined = pd.concat([dummies1, dummies2], axis=1)
    
    # For each row, check if categories match
    # This is simplified - for true nominal dissimilarity, we use matching coefficient
    matches = 0
    total = len(attr1)
    
    for i in range(total):
        # Get categories for each attribute
        cat1 = attr1.iloc[i] if hasattr(attr1, 'iloc') else attr1[i]
        cat2 = attr2.iloc[i] if hasattr(attr2, 'iloc') else attr2[i]
        
        # Simple matching: compare if categories are exactly same
        # Since they're different attributes, we can't directly compare
        # Instead, we compute dissimilarity based on co-occurrence patterns
    
    # For nominal attributes, we use chi-square based distance or simple matching
    # Let's use a different approach - Gini impurity or entropy-based
    from scipy.stats import chi2_contingency
    
    chi2, p, dof, expected = chi2_contingency(contingency)
    print(f"\nChi-square statistic: {chi2:.4f}")
    print(f"P-value: {p:.4f}")
    print(f"Degrees of freedom: {dof}")
    
    # Normalize chi-square to get dissimilarity measure
    # Cramer's V (ranges from 0 to 1)
    n = contingency.sum().sum()
    cramers_v = np.sqrt(chi2 / (n * min(contingency.shape[0]-1, contingency.shape[1]-1)))
    print(f"\nCramer's V (dissimilarity measure): {cramers_v:.4f}")
    print("Interpretation: 0 = no association, 1 = perfect association")
    
    return cramers_v

