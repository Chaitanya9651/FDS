# ==================== TITANIC: Part D - Dissimilarity for Numeric Attributes ====================
print("\n" + "="*50)
print("DISSIMILARITY MEASURES FOR NUMERIC ATTRIBUTES")
print("="*50)

# Select two numeric attributes: 'age' and 'fare'
print("\nMeasuring dissimilarity between 'age' and 'fare':")

# Extract numeric attributes and remove NaN
age_fare_df = titanic[['age', 'fare']].dropna()
age = age_fare_df['age'].values
fare = age_fare_df['fare'].values

# 1. Euclidean distance (normalized)
from sklearn.preprocessing import StandardScaler

# Normalize the data
scaler = StandardScaler()
age_fare_normalized = scaler.fit_transform(age_fare_df)

# Calculate Euclidean distance for each pair (sample-wise)
euclidean_distances = np.sqrt(np.sum((age_fare_normalized)**2, axis=1))
print(f"\n1. Euclidean Distance (normalized):")
print(f"   Mean distance: {np.mean(euclidean_distances):.4f}")
print(f"   Std distance: {np.std(euclidean_distances):.4f}")
print(f"   Min distance: {np.min(euclidean_distances):.4f}")
print(f"   Max distance: {np.max(euclidean_distances):.4f}")

# 2. Manhattan distance (normalized)
manhattan_distances = np.sum(np.abs(age_fare_normalized), axis=1)
print(f"\n2. Manhattan Distance (normalized):")
print(f"   Mean distance: {np.mean(manhattan_distances):.4f}")
print(f"   Std distance: {np.std(manhattan_distances):.4f}")
print(f"   Min distance: {np.min(manhattan_distances):.4f}")
print(f"   Max distance: {np.max(manhattan_distances):.4f}")

# 3. Correlation-based dissimilarity
correlation = np.corrcoef(age, fare)[0, 1]
dissimilarity_corr = 1 - abs(correlation)
print(f"\n3. Correlation-based Dissimilarity:")
print(f"   Correlation coefficient: {correlation:.4f}")
print(f"   Dissimilarity (1 - |r|): {dissimilarity_corr:.4f}")

# 4. Cosine dissimilarity
def cosine_similarity(a, b):
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))

cosine_sim = cosine_similarity(age, fare)
cosine_dissim = 1 - abs(cosine_sim)
print(f"\n4. Cosine Dissimilarity:")
print(f"   Cosine similarity: {cosine_sim:.4f}")
print(f"   Cosine dissimilarity: {cosine_dissim:.4f}")

